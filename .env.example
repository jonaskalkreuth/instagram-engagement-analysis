# Copy to .env and fill in. .env is git-ignored — never commit real values.
# Meta app + IG token: see docs/setup-meta-auth.md.
# App id/secret go in by hand; the token + user id are filled by:
#   uv run python -m insta_analytics.collect.auth --short-token <TOKEN> --write

# --- Secrets ---
INSTA_META_APP_ID=your_app_id
INSTA_META_APP_SECRET=your_app_secret
INSTA_IG_ACCESS_TOKEN=your_long_lived_token
INSTA_IG_USER_ID=your_ig_business_user_id

# --- Optional knobs (defaults shown) ---
INSTA_GRAPH_API_VERSION=v21.0
# Selects the DB path: synthetic → data/synthetic/insta.duckdb (fake, tracked;
# the deploy default), real → data/processed/insta.duckdb (private, git-ignored).
# Set to `real` locally to run collection/analysis on your own data.
# synthetic | real
INSTA_DATA_SOURCE=synthetic
